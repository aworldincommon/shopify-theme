{%- liquid
  assign first_product = collections.all.products.first
  assign ledger_url = pages['transparency-ledger'].url | default: routes.root_url
-%}

{%- comment -%}
  Masthead: the shop name is the visible h1, set like a magazine nameplate. One primary action only;
  it points at the object on this page rather than a product that is not on sale yet.
{%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', attributes: 'aria-labelledby="home-masthead"' %}
  <div class="flex flex-col gap-8 pt-4 pb-16 border-b-8 border-accent md:gap-12 md:pb-24">
    {%- comment -%} Dateline row: a masthead convention that also states the store's real status. {%- endcomment -%}
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 pb-3 border-b-2 border-on-surface">
      {% block 'text', variant: 'sm', class: 'font-mono uppercase tracking-widest text-army' %}{{ 'wic.home.hero_status_1' | t }}{% endblock %}
      {% block 'text', variant: 'sm', class: 'font-mono uppercase tracking-widest' %}{{ 'wic.home.hero_kicker' | t }}{% endblock %}
    </div>

    {% block 'heading', tag: 'h1', variant: 'xl', class: 'max-w-5xl sm:text-8xl lg:text-9xl leading-[0.85] tracking-tighter', attributes: 'id="home-masthead"' %}{{ shop.name }}{% endblock %}

    {%- comment -%} Asymmetric 3 / 6 / 3 split: the stamp sits in the margin column like a marginal note. {%- endcomment -%}
    <div class="grid gap-8 pt-6 border-t border-dashed border-on-surface md:grid-cols-12 md:items-end">
      <div class="md:col-span-3 md:self-start">
        <div class="inline-block -rotate-3 border-2 border-accent bg-accent px-3 py-2 text-surface">
          {% block 'text', variant: 'sm', class: 'font-mono uppercase tracking-widest' %}{{ 'wic.home.hero_stamp' | t }}{% endblock %}
        </div>
      </div>

      {% block 'text', variant: 'lg', class: 'md:col-span-6 max-w-prose md:text-3xl leading-snug text-balance' %}{{ 'wic.home.hero_lede' | t }}{% endblock %}

      <div class="md:col-span-3 md:justify-self-end">
        {% block 'button', url: '#object-001', variant: 'button-primary', class: 'h-12 px-6 text-sm rounded-button' %}{{ 'wic.home.hero_cta' | t }}{% endblock %}
      </div>
    </div>
  </div>
{% endblock %}

{%- comment -%}
  Object 001, staged as a specimen with its receipt, not a product card. Every receipt value is a placeholder
  until real costs exist; never render product price or invented specs here. The id is the masthead CTA's anchor.
{%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin scroll-mt-8', attributes: 'id="object-001" aria-labelledby="home-shirt-heading"' %}
  <div class="grid gap-x-8 gap-y-10 pt-4 pb-16 border-t-2 border-on-surface md:grid-cols-12 md:pb-24">
    {% block 'text', variant: 'sm', class: 'md:col-span-12 font-mono uppercase tracking-widest text-army' %}{{ 'wic.home.shirt_kicker' | t }}{% endblock %}

    {% block 'heading', tag: 'h2', variant: 'xl', class: 'md:col-span-10 lg:text-8xl leading-[0.9] tracking-tighter text-balance', attributes: 'id="home-shirt-heading"' %}{{ 'wic.home.shirt_title' | t }}{% endblock %}

    <div class="md:col-span-7">
      {%- if first_product.featured_image -%}
        {% block 'image', fallback_image: first_product.featured_image, aspect_ratio: 'aspect-[4/5]', sizes: '(min-width: 768px) 55vw, 100vw', alt: first_product.title, attributes: 'loading="lazy"' %}{% endblock %}
      {%- else -%}
        {%- comment -%} Honest empty frame until a real photograph exists: no mockups, no stock imagery. {%- endcomment -%}
        <div class="aspect-[4/5] flex flex-col justify-between p-6 border-2 border-dashed border-on-surface">
          <span class="font-heading text-8xl leading-none tracking-tighter" aria-hidden="true">001</span>
          {% block 'text', variant: 'sm', class: 'font-mono uppercase tracking-widest max-w-xs' %}{{ 'wic.home.shirt_photo_pending' | t }}{% endblock %}
        </div>
      {%- endif -%}
    </div>

    <div class="flex flex-col gap-8 md:col-span-5 lg:col-span-4 lg:col-start-9 md:self-end">
      {% block 'text', variant: 'lg', class: 'max-w-prose leading-relaxed' %}{{ 'wic.home.shirt_body' | t }}{% endblock %}

      {%- comment -%} Receipt slip: four lines, not a spreadsheet. Leaders appear from sm up so long placeholders never collide. {%- endcomment -%}
      <div class="bg-surface-secondary border-y-2 border-dashed border-on-surface px-5 py-5">
        {% block 'text', variant: 'sm', class: 'font-mono uppercase tracking-widest pb-3 border-b border-dashed border-on-surface' %}{{ 'wic.home.receipt_head' | t }}{% endblock %}
        <dl class="flex flex-col divide-y divide-rule">
          <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-3">
            <dt>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono' %}{{ 'wic.home.receipt_price' | t }}{% endblock %}</dt>
            <span class="hidden sm:flex flex-1 border-b border-dotted border-on-surface/50" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono text-accent' %}{{ 'wic.home.receipt_tbd' | t }}{% endblock %}</dd>
          </div>
          <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-3">
            <dt>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono' %}{{ 'wic.home.receipt_cost' | t }}{% endblock %}</dt>
            <span class="hidden sm:flex flex-1 border-b border-dotted border-on-surface/50" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono text-accent' %}{{ 'wic.home.receipt_pending' | t }}{% endblock %}</dd>
          </div>
          <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:gap-3">
            <dt>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono' %}{{ 'wic.home.receipt_contribution' | t }}{% endblock %}</dt>
            <span class="hidden sm:flex flex-1 border-b border-dotted border-on-surface/50" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono text-accent' %}{{ 'wic.home.receipt_pending' | t }}{% endblock %}</dd>
          </div>
          <div class="flex flex-col gap-1 py-3 font-bold sm:flex-row sm:items-baseline sm:gap-3">
            <dt>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono font-bold' %}{{ 'wic.home.receipt_status' | t }}{% endblock %}</dt>
            <span class="hidden sm:flex flex-1 border-b border-dotted border-on-surface/50" aria-hidden="true"></span>
            <dd>{% block 'text', tag: 'span', variant: 'sm', class: 'font-mono font-bold' %}{{ 'wic.home.receipt_status_value' | t }}{% endblock %}</dd>
          </div>
        </dl>
        {% block 'text', variant: 'sm', class: 'font-mono pt-3 border-t border-dashed border-on-surface' %}{{ 'wic.home.receipt_foot' | t }}{% endblock %}
      </div>

      {%- if first_product -%}
        {% block 'link', url: first_product.url, class: 'font-mono text-sm uppercase tracking-widest' %}{{ 'wic.home.shirt_cta' | t }}{% endblock %}
      {%- endif -%}
    </div>
  </div>
{% endblock %}

{%- comment -%} Subjects run together like a cover line, so eight topics read as one statement instead of eight ruled rows. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', attributes: 'aria-labelledby="home-topics-heading"' %}
  <div class="grid gap-8 pt-4 pb-16 border-t-2 border-on-surface md:grid-cols-12 md:pb-24">
    <div class="flex flex-col gap-3 md:col-span-3">
      {% block 'text', tag: 'h2', variant: 'sm', class: 'font-mono uppercase tracking-widest text-army', attributes: 'id="home-topics-heading"' %}{{ 'wic.home.topics_title' | t }}{% endblock %}
      {% block 'text', variant: 'sm', class: 'max-w-xs' %}{{ 'wic.home.topics_body' | t }}{% endblock %}
    </div>

    {%- comment -%} role="list" keeps list semantics that Safari drops from inline list items. The red slashes are decorative. {%- endcomment -%}
    <ul role="list" class="md:col-span-9 leading-tight">
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_1' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_2' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_3' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_4' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_5' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_6' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_7' | t }}{% endblock %}<span class="font-heading text-3xl md:text-5xl text-accent" aria-hidden="true"> / </span></li>
      <li class="inline-block align-baseline">{% block 'heading', tag: 'span', variant: 'sm', class: 'md:text-5xl tracking-tight' %}{{ 'wic.home.topic_8' | t }}{% endblock %}</li>
    </ul>
  </div>
{% endblock %}

{%- comment -%} The only full-bleed band: black ink, closing the page on the ledger, the project's core trust mechanism. {%- endcomment -%}
{% block 'container', class: 'bg-on-surface text-surface', attributes: 'aria-labelledby="home-ledger-heading"' %}
  <div class="max-w-page mx-auto px-margin py-16 md:py-24 grid gap-10 md:grid-cols-12 md:items-end">
    {% block 'heading', tag: 'h2', variant: 'xl', class: 'md:col-span-8 lg:text-8xl leading-[0.9] tracking-tighter text-balance', attributes: 'id="home-ledger-heading"' %}{{ 'wic.home.ledger_title' | t }}{% endblock %}
    <div class="flex flex-col items-start gap-6 md:col-span-4">
      {% block 'text', variant: 'lg', class: 'max-w-prose leading-relaxed text-surface/80' %}{{ 'wic.home.ledger_lede' | t }}{% endblock %}
      {% block 'button', url: ledger_url, variant: 'button-surface', class: 'h-12 px-6 text-sm rounded-button' %}{{ 'wic.home.ledger_cta' | t }}{% endblock %}
    </div>
  </div>
{% endblock %}
