{% block 'container', class: 'max-w-page mx-auto px-margin w-full', attributes: 'aria-labelledby="ai-title"' %}
  <div class="pt-16 pb-12 md:pt-24 md:pb-16 flex flex-col gap-6 border-b-2 border-on-surface">
    {% block 'heading', tag: 'h1', variant: '2xl', class: 'text-5xl md:text-8xl leading-[0.95] tracking-tight', attributes: 'id="ai-title"' %}{{ page.title | escape }}{% endblock %}
    {% block 'text', variant: 'lg', class: 'max-w-prose leading-relaxed' %}{{ 'wic.ai.intro' | t }}{% endblock %}
  </div>
{% endblock %}

{% block 'container', class: 'max-w-page mx-auto px-margin w-full' %}
  <blockquote class="py-12 md:py-20">
    {% block 'text', tag: 'p', variant: 'lg', class: 'font-heading text-2xl md:text-4xl leading-snug tracking-tight max-w-4xl text-balance' %}{{ 'wic.ai.principle' | t }}{% endblock %}
  </blockquote>
{% endblock %}

{% block 'container', class: 'max-w-page mx-auto px-margin w-full' %}
  <div class="pb-16 md:pb-24 grid gap-12 md:grid-cols-2">
    <div class="flex flex-col gap-4 border-t border-rule pt-6">
      {% block 'heading', tag: 'h2', variant: 'sm', class: 'leading-tight tracking-tight text-accent' %}{{ 'wic.ai.harms_title' | t }}{% endblock %}
      {% block 'text', class: 'max-w-prose leading-relaxed' %}{{ 'wic.ai.harms_body' | t }}{% endblock %}
    </div>
    <div class="flex flex-col gap-4 border-t border-rule pt-6">
      {% block 'heading', tag: 'h2', variant: 'sm', class: 'leading-tight tracking-tight' %}{{ 'wic.ai.social_title' | t }}{% endblock %}
      {% block 'text', class: 'max-w-prose leading-relaxed' %}{{ 'wic.ai.social_body' | t }}{% endblock %}
    </div>
  </div>
{% endblock %}

{% block 'container', class: 'bg-on-surface text-surface' %}
  <div class="max-w-page mx-auto px-margin py-16 md:py-24">
    {% block 'text', tag: 'p', variant: 'lg', class: 'font-heading text-3xl md:text-5xl leading-tight tracking-tight max-w-5xl text-balance' %}{{ 'wic.ai.statement' | t }}{% endblock %}
  </div>
{% endblock %}

{% block 'container', class: 'max-w-page mx-auto px-margin w-full' %}
  <div class="py-16 md:py-20">
    <aside class="max-w-2xl border-2 border-accent p-6 md:p-8 flex flex-col gap-3" aria-labelledby="ai-note-title">
      {% block 'text', tag: 'h2', variant: 'sm', class: 'font-mono uppercase tracking-widest text-accent', attributes: 'id="ai-note-title"' %}{{ 'wic.ai.note_title' | t }}{% endblock %}
      {% block 'text', variant: 'lg', class: 'leading-relaxed' %}{{ 'wic.ai.note_body' | t }}{% endblock %}
    </aside>
    {%- if page.content != blank -%}
      {% block 'richtext', text: page.content, class: 'max-w-prose mt-12' %}{% endblock %}
    {%- endif -%}
  </div>
{% endblock %}
