{{ 'section-wic-editorial.css' | asset_url | stylesheet_tag }}
{{ 'section-wic-shelf.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Influences: the books and people behind the project. Books render as a shelf of cards, people as a
  ledger-style list below them. Each group only renders when it has blocks.
{%- endcomment -%}
{%- liquid
  assign book_count = 0
  assign person_count = 0
  for block in section.blocks
    case block.type
      when 'book'
        assign book_count = book_count | plus: 1
      when 'person'
        assign person_count = person_count | plus: 1
    endcase
  endfor
-%}

<div class="wic-shelf color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="wic-shelf__head wic-top-rule">
      {%- if section.settings.kicker != blank -%}
        <p class="wic-shelf__kicker wic-mono wic-accent-burgundy">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wic-shelf__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="wic-shelf__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- if book_count > 0 -%}
      {%- if section.settings.books_label != blank -%}
        <h3 class="wic-shelf__label wic-mono">{{ section.settings.books_label | escape }}</h3>
      {%- endif -%}
      <ol class="wic-shelf__books list-unstyled" role="list">
        {%- assign book_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'book' -%}
            {%- assign book_number = book_number | plus: 1 -%}
            <li class="wic-shelf__book" {{ block.shopify_attributes }}>
              <p class="wic-shelf__book-number wic-mono" aria-hidden="true">
                {%- if book_number < 10 %}0{% endif %}{{ book_number -}}
              </p>
              <h4 class="wic-shelf__book-title">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </h4>
              {%- if block.settings.author != blank -%}
                <p class="wic-shelf__book-author wic-mono">{{ block.settings.author | escape }}</p>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="wic-shelf__book-note">{{ block.settings.note | escape }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if person_count > 0 -%}
      {%- if section.settings.people_label != blank -%}
        <h3 class="wic-shelf__label wic-mono">{{ section.settings.people_label | escape }}</h3>
      {%- endif -%}
      <ul class="wic-shelf__people list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'person' -%}
            <li class="wic-shelf__person" {{ block.shopify_attributes }}>
              <h4 class="wic-shelf__person-name">{{ block.settings.name | escape }}</h4>
              {%- if block.settings.note != blank -%}
                <p class="wic-shelf__person-note">{{ block.settings.note | escape }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <p class="wic-shelf__more">
        <a href="{{ section.settings.link }}" class="button button--secondary">{{ section.settings.link_label | escape }}</a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.wic_shelf.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.wic_shelf.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.wic_shelf.settings.heading.label",
      "default": "Influences"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.wic_shelf.settings.intro.label"
    },
    {
      "type": "text",
      "id": "books_label",
      "label": "t:sections.wic_shelf.settings.books_label.label",
      "default": "Books"
    },
    {
      "type": "text",
      "id": "people_label",
      "label": "t:sections.wic_shelf.settings.people_label.label",
      "default": "People"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.wic_shelf.settings.link_label.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.wic_shelf.settings.link.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "book",
      "name": "t:sections.wic_shelf.blocks.book.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.wic_shelf.blocks.book.settings.title.label" },
        { "type": "text", "id": "author", "label": "t:sections.wic_shelf.blocks.book.settings.author.label" },
        { "type": "textarea", "id": "note", "label": "t:sections.wic_shelf.blocks.book.settings.note.label" },
        { "type": "url", "id": "link", "label": "t:sections.wic_shelf.blocks.book.settings.link.label" }
      ]
    },
    {
      "type": "person",
      "name": "t:sections.wic_shelf.blocks.person.name",
      "settings": [
        { "type": "text", "id": "name", "label": "t:sections.wic_shelf.blocks.person.settings.name.label" },
        { "type": "textarea", "id": "note", "label": "t:sections.wic_shelf.blocks.person.settings.note.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.wic_shelf.name",
      "blocks": [{ "type": "book" }, { "type": "book" }, { "type": "person" }]
    }
  ]
}
{% endschema %}
