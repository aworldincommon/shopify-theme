{%- comment -%}
  World in Common: link-in-bio page (our own Linktree).
  Blocks: link (label, note, url, featured), social (platform + url).
  Internal links get ?utm_source=<utm_source> so Shopify analytics shows bio traffic.
{%- endcomment -%}

<section class="wic-links" aria-labelledby="WicLinksTitle-{{ section.id }}">
  <div class="wic-links__inner">
    <header class="wic-links__head">
      <img
        class="wic-links__logo"
        src="{{ 'wic-logo.svg' | asset_url }}"
        alt=""
        width="88"
        height="88"
        loading="eager"
      >
      <h1 id="WicLinksTitle-{{ section.id }}" class="wic-links__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.tagline != blank -%}
        <p class="wic-links__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="wic-links__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' and block.settings.url != blank -%}
          {%- liquid
            assign href = block.settings.url
            assign first = href | slice: 0
            if first == '/' and section.settings.utm_source != blank
              if href contains '?'
                assign href = href | append: '&utm_source=' | append: section.settings.utm_source
              else
                assign href = href | append: '?utm_source=' | append: section.settings.utm_source
              endif
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a
              class="wic-links__link{% if block.settings.featured %} wic-links__link--featured{% endif %}"
              href="{{ href }}"
              {%- if first != '/' %} target="_blank" rel="noopener"{% endif %}
            >
              {%- if block.settings.kicker != blank -%}
                <span class="wic-links__kicker">{{ block.settings.kicker | escape }}</span>
              {%- endif -%}
              <span class="wic-links__label">{{ block.settings.label | escape }}</span>
              {%- if block.settings.note != blank -%}
                <span class="wic-links__note">{{ block.settings.note | escape }}</span>
              {%- endif -%}
              <span class="wic-links__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- assign has_social = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'social' and block.settings.url != blank -%}{%- assign has_social = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_social -%}
      <nav class="wic-links__social" aria-label="{{ section.settings.social_label | escape }}">
        <ul role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' and block.settings.url != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url }}" target="_blank" rel="noopener">
                  {%- case block.settings.platform -%}
                    {%- when 'youtube' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9l5.8 3.1-5.8 3.1z"/></svg>
                    {%- when 'tiktok' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.2a6.3 6.3 0 1 0 5.4 6.2V8.6a8 8 0 0 0 4.7 1.5V6.7a4.7 4.7 0 0 1-4.7-4.7z"/></svg>
                    {%- when 'instagram' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3c1.2-.1 1.6-.1 4.8-.1zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.1-9.4a1.2 1.2 0 1 0 0 2.3 1.2 1.2 0 0 0 0-2.3z"/></svg>
                  {%- endcase -%}
                  <span class="visually-hidden">{{ block.settings.platform | capitalize }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <footer class="wic-links__foot">
      <a href="{{ routes.root_url }}">{{ shop.domain | remove: 'www.' }}</a>
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "Link in bio",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "World in Common" },
    { "type": "text", "id": "tagline", "label": "Tagline" },
    { "type": "text", "id": "utm_source", "label": "Tracking tag added to internal links", "default": "linkinbio" },
    { "type": "text", "id": "social_label", "label": "Social links label (screen readers)", "default": "Follow us" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker (small line above)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Read the manifesto" },
        { "type": "text", "id": "note", "label": "Note (small line below)" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "checkbox", "id": "featured", "label": "Featured (burgundy)", "default": false }
      ]
    },
    {
      "type": "social",
      "name": "Social icon",
      "settings": [
        {
          "type": "select", "id": "platform", "label": "Platform", "default": "instagram",
          "options": [
            { "value": "youtube", "label": "YouTube" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "instagram", "label": "Instagram" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Link in bio" }]
}
{% endschema %}
