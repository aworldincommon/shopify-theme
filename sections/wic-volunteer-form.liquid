{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'section-wic-editorial.css' | asset_url | stylesheet_tag }}
{{ 'section-wic-volunteer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Volunteer sign-up. Uses Shopify's contact form, so submissions arrive in the store's contact inbox.
  Role checkboxes are built from the role list in the section settings (one role per line) and can be
  pre-ticked by the "I'm in" links in the wic-roles section.
{%- endcomment -%}
<div id="VolunteerForm" class="wic-volunteer color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="wic-volunteer__head wic-top-rule">
      {%- if section.settings.heading != blank -%}
        <h2 class="wic-volunteer__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="wic-volunteer__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'WicVolunteerForm', class: 'wic-volunteer__form isolate' -%}
      <input type="hidden" name="contact[Form]" value="Volunteer sign-up">
      <input type="hidden" name="contact[tags]" value="volunteer">

      {%- if form.posted_successfully? -%}
        <div class="wic-volunteer__success" tabindex="-1" autofocus>
          <p class="wic-volunteer__stamp wic-mono">{{ 'sections.wic_volunteer.received' | t }}</p>
          <div class="rte">{{ section.settings.success_text }}</div>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="form__message" role="alert">
            <h3 class="form-status caption-large text-body">
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
            <p class="caption-large">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          </div>
        {%- endif -%}

        <div class="contact__fields">
          <div class="field">
            <input
              class="field__input"
              autocomplete="name"
              type="text"
              id="WicVolunteer-name"
              name="contact[Name]"
              value="{{ form.name }}"
              placeholder="{{ 'sections.wic_volunteer.name' | t }}"
              required
            >
            <label class="field__label" for="WicVolunteer-name">{{ 'sections.wic_volunteer.name' | t }} <span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input
              autocomplete="email"
              type="email"
              id="WicVolunteer-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{{ form.email }}"
              aria-required="true"
              placeholder="{{ 'templates.contact.form.email' | t }}"
              required
            >
            <label class="field__label" for="WicVolunteer-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          </div>
        </div>

        <fieldset class="wic-volunteer__roles">
          <legend class="wic-volunteer__legend">{{ 'sections.wic_volunteer.roles_legend' | t }}</legend>
          {%- assign role_lines = section.settings.roles | newline_to_br | split: '<br />' -%}
          <div class="wic-volunteer__role-grid">
            {%- for line in role_lines -%}
              {%- assign role = line | strip -%}
              {%- if role != blank -%}
                {%- assign role_slug = role | handleize -%}
                <label class="wic-volunteer__chip" for="WicVolunteer-role-{{ role_slug }}">
                  <input
                    type="checkbox"
                    id="WicVolunteer-role-{{ role_slug }}"
                    name="contact[Role: {{ role | escape }}]"
                    value="yes"
                    data-wic-role-box="{{ role_slug }}"
                  >
                  <span>{{ role | escape }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>

        <div class="field">
          <input
            class="field__input"
            type="text"
            id="WicVolunteer-where"
            name="contact[Where are you based]"
            placeholder="{{ 'sections.wic_volunteer.where' | t }}"
          >
          <label class="field__label" for="WicVolunteer-where">{{ 'sections.wic_volunteer.where' | t }}</label>
        </div>

        <div class="field">
          <input
            class="field__input"
            type="text"
            id="WicVolunteer-links"
            name="contact[Portfolio or links]"
            placeholder="{{ 'sections.wic_volunteer.links' | t }}"
          >
          <label class="field__label" for="WicVolunteer-links">{{ 'sections.wic_volunteer.links' | t }}</label>
        </div>

        <div class="field">
          <select class="field__input wic-volunteer__select" id="WicVolunteer-time" name="contact[Time]">
            <option value="">{{ 'sections.wic_volunteer.time_pick' | t }}</option>
            <option>{{ 'sections.wic_volunteer.time_1' | t }}</option>
            <option>{{ 'sections.wic_volunteer.time_2' | t }}</option>
            <option>{{ 'sections.wic_volunteer.time_3' | t }}</option>
            <option>{{ 'sections.wic_volunteer.time_4' | t }}</option>
          </select>
          <label class="field__label wic-volunteer__select-label" for="WicVolunteer-time">{{ 'sections.wic_volunteer.time' | t }}</label>
        </div>

        <div class="field">
          <textarea
            rows="6"
            id="WicVolunteer-body"
            class="text-area field__input"
            name="contact[body]"
            placeholder="{{ 'sections.wic_volunteer.message' | t }}"
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label" for="WicVolunteer-body">{{ 'sections.wic_volunteer.message' | t }}</label>
        </div>

        <label class="wic-volunteer__consent" for="WicVolunteer-consent">
          <input type="checkbox" id="WicVolunteer-consent" name="contact[Consent]" value="yes" required>
          <span>{{ section.settings.consent_text | escape }}</span>
        </label>

        <div class="contact__button">
          <button type="submit" class="button button--primary">{{ section.settings.button_label | escape }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.wic_volunteer_form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.wic_volunteer_form.settings.heading.label",
      "default": "Join us"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.wic_volunteer_form.settings.intro.label"
    },
    {
      "type": "textarea",
      "id": "roles",
      "label": "t:sections.wic_volunteer_form.settings.roles.label",
      "info": "t:sections.wic_volunteer_form.settings.roles.info"
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "t:sections.wic_volunteer_form.settings.consent_text.label",
      "default": "We only use these details to reply to you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.wic_volunteer_form.settings.button_label.label",
      "default": "Join us"
    },
    {
      "type": "richtext",
      "id": "success_text",
      "label": "t:sections.wic_volunteer_form.settings.success_text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.wic_volunteer_form.name"
    }
  ]
}
{% endschema %}
