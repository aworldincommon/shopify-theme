{{ 'section-wic-editorial.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Topics run together like a cover line, so the list reads as one statement rather than a card grid.
  role="list" keeps list semantics that Safari drops when list-style is removed.
{%- endcomment -%}
<div class="wic-topics color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="wic-topics__grid wic-top-rule">
      <div class="wic-topics__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="wic-topics__heading wic-mono wic-accent-burgundy">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="wic-topics__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.emblem_image != blank or section.settings.emblem != 'none' -%}
          <div class="wic-topics__emblem">
            {%- render 'wic-emblem',
              image: section.settings.emblem_image,
              emblem: section.settings.emblem,
              class: 'wic-emblem',
              sizes: '(min-width: 750px) 22vw, 60vw'
            -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="wic-topics__list list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li class="wic-topics__item" {{ block.shopify_attributes }}>
              {{- block.settings.topic | escape -}}
              {%- unless forloop.last -%}
                <span class="wic-topics__slash" aria-hidden="true"> / </span>
              {%- endunless -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.wic_topics.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.wic_topics.settings.heading.label",
      "default": "Problems are easy to find. We are looking for solutions!"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.wic_topics.settings.text.label",
      "default": "It's time to take matters into our own hands. We cannot trust the machine to fix itself."
    },
    {
      "type": "header",
      "content": "t:sections.wic_shared.settings.emblem_header.content"
    },
    {
      "type": "select",
      "id": "emblem",
      "label": "t:sections.wic_shared.settings.emblem.label",
      "info": "t:sections.wic_shared.settings.emblem.info",
      "options": [
        { "value": "arch", "label": "t:sections.wic_shared.settings.emblem.options__arch" },
        { "value": "roof", "label": "t:sections.wic_shared.settings.emblem.options__roof" },
        { "value": "none", "label": "t:sections.wic_shared.settings.emblem.options__none" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "emblem_image",
      "label": "t:sections.wic_shared.settings.emblem_image.label",
      "info": "t:sections.wic_shared.settings.emblem_image.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "t:sections.wic_topics.blocks.topic.name",
      "settings": [
        {
          "type": "text",
          "id": "topic",
          "label": "t:sections.wic_topics.blocks.topic.settings.topic.label",
          "default": "Community and belonging"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.wic_topics.name",
      "blocks": [
        {
          "type": "topic"
        }
      ]
    }
  ]
}
{% endschema %}
