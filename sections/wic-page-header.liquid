{{ 'section-wic-editorial.css' | asset_url | stylesheet_tag }}
{{ 'section-wic-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
  assign has_emblem = false
  if section.settings.emblem_image != blank or section.settings.emblem != 'none'
    assign has_emblem = true
  endif
-%}

{%- comment -%}
  The page h1. The title falls back to the Admin page title, so the page record and the template stay in step.
{%- endcomment -%}
<div class="wic-page-header color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.kicker != blank -%}
      <p class="wic-page-header__kicker wic-mono wic-accent-burgundy">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}

    <div class="wic-page-header__grid{% if has_emblem %} wic-page-header__grid--emblem{% endif %}">
      <div class="wic-page-header__main">
        <h1 class="wic-page-header__title">{{ heading | escape }}</h1>
        <div class="wic-rule wic-rule--stamp" aria-hidden="true"></div>

        {%- if section.settings.intro != blank -%}
          <div class="wic-page-header__intro">{{ section.settings.intro }}</div>
        {%- endif -%}

        {%- if section.settings.show_page_content and page.content != blank -%}
          <div class="wic-page-header__content rte">{{ page.content }}</div>
        {%- endif -%}
      </div>

      {%- if has_emblem -%}
        <div class="wic-page-header__emblem">
          {%- render 'wic-emblem',
            image: section.settings.emblem_image,
            emblem: section.settings.emblem,
            class: 'wic-emblem',
            loading: 'eager',
            sizes: '(min-width: 750px) 28vw, 70vw'
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.wic_page_header.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.wic_page_header.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.wic_page_header.settings.heading.label",
      "info": "t:sections.wic_page_header.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.wic_page_header.settings.intro.label"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "t:sections.wic_page_header.settings.show_page_content.label",
      "info": "t:sections.wic_page_header.settings.show_page_content.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.wic_shared.settings.emblem_header.content"
    },
    {
      "type": "select",
      "id": "emblem",
      "label": "t:sections.wic_shared.settings.emblem.label",
      "info": "t:sections.wic_shared.settings.emblem.info",
      "options": [
        { "value": "arch", "label": "t:sections.wic_shared.settings.emblem.options__arch" },
        { "value": "roof", "label": "t:sections.wic_shared.settings.emblem.options__roof" },
        { "value": "none", "label": "t:sections.wic_shared.settings.emblem.options__none" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "emblem_image",
      "label": "t:sections.wic_shared.settings.emblem_image.label",
      "info": "t:sections.wic_shared.settings.emblem_image.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "t:sections.wic_page_header.name"
    }
  ]
}
{% endschema %}
